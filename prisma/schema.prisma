datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id              String              @id @default(uuid())
  slug            String              @unique
  title           String
  description     String              @db.Text
  fullDescription String?             @db.Text
  category        String              @default("Software Development")
  featured        Boolean             @default(false)
  demoUrl         String?
  repoUrl         String?
  thumbnailUrl    String?
  technologies    ProjectTechnology[]
  images          ProjectImage[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([category])
  @@index([featured])
}

model ProjectTechnology {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  icon      String?

  @@index([projectId])
}

model ProjectImage {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  order     Int     @default(0)

  @@index([projectId])
}

model Internship {
  id          String              @id @default(uuid())
  slug        String              @unique
  company     String
  role        String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean             @default(false)
  description String              @db.Text
  highlights  String[]
  projects    InternshipProject[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model InternshipProject {
  id           String     @id @default(uuid())
  internshipId String
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  title        String
  description  String     @db.Text

  @@index([internshipId])
}

model Certificate {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  issuer        String
  issueDate     DateTime
  credentialId  String?
  credentialUrl String?
  imageUrl      String?
  skills        String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String   @default("General")
  proficiency Int?     @default(80)
  icon        String?
  featured    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model Education {
  id          String    @id @default(uuid())
  institution String
  degree      String
  fieldOfStudy String
  startDate   DateTime
  endDate     DateTime?
  grade       String?
  activities  String?   @db.Text
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Achievement {
  id          String   @id @default(uuid())
  title       String
  issuer      String
  date        DateTime
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventName String
  path      String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventName])
  @@index([path])
}
