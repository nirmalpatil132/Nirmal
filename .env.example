# =============================================================================
# NIRMAL PORTFOLIO V2 — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT SETTINGS (Used when running locally via npm run dev)
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
PORT=4000

# Local PostgreSQL Database (Optional - email delivers even if DB is offline)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nirmal_portfolio?schema=public"

# Frontend local API URL (Defaults to http://localhost:4000 in local dev)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. PRODUCTION BACKEND SETTINGS (Set in Render / Railway / Server Dashboard)
# -----------------------------------------------------------------------------
# NODE_ENV=production
# PORT=10000 (Provided automatically by cloud host)
# CORS_ORIGIN=https://nirmalpatil132.github.io

# Transactional Email Service (Resend recommended)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_live_api_key_here
# EMAIL_FROM=onboarding@resend.dev
# CONTACT_TO_EMAIL=nirmalpatil615@gmail.com

# -----------------------------------------------------------------------------
# 3. PRODUCTION FRONTEND SETTINGS (Set in GitHub Secrets or GitHub Pages workflow)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://nirmal-portfolio-api.onrender.com
# NEXT_PUBLIC_SITE_URL=https://nirmalpatil132.github.io/Nirmal
