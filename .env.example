# =============================================================================
# NIRMAL PORTFOLIO V2 — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT SETTINGS (Used when running locally via npm run dev)
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
PORT=4000

# Local PostgreSQL Database (Optional - email delivers even if DB is offline)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nirmal_portfolio?schema=public"

# Frontend local API URL (Defaults to http://localhost:4000 in local dev)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. PRODUCTION BACKEND SETTINGS (Set in Render / Railway Dashboard)
# -----------------------------------------------------------------------------
# NODE_ENV=production
# PORT=10000 (Render automatically sets this; backend listens to process.env.PORT)
# CORS_ORIGIN=https://nirmalpatil132.github.io

# Backend email configuration (RESEND_API_KEY is backend-only; NEVER put in frontend)
# Production requires a valid provider configuration:
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# EMAIL_FROM must be a sender address from a domain verified in your Resend account (e.g. contact@yourdomain.com)
EMAIL_FROM=
# EMAIL_TO is the portfolio owner's inbox where inquiries arrive
EMAIL_TO=nirmalpatil615@gmail.com

# Optional legacy alias (EMAIL_TO takes precedence)
# CONTACT_TO_EMAIL=nirmalpatil615@gmail.com

# -----------------------------------------------------------------------------
# 3. PRODUCTION FRONTEND SETTINGS (Set in GitHub Secrets or GitHub Pages workflow)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://nirmal-portfolio-api.onrender.com
# NEXT_PUBLIC_SITE_URL=https://nirmalpatil132.github.io/Nirmal
