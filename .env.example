# Server & Environment Configuration
NODE_ENV=development
API_PORT=4000

# Database Connection (PostgreSQL - Optional for local API message persistence)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nirmal_portfolio?schema=public"

# CORS Configuration (Allowed origins for Express API)
CORS_ORIGIN=https://nirmalpatil132.github.io

# Frontend Public API URL (Set to deployed Express API URL in production; e.g., https://api.yourdomain.com)
NEXT_PUBLIC_API_URL=

# Public Portfolio Canonical URL
NEXT_PUBLIC_SITE_URL=https://nirmalpatil132.github.io/Nirmal

# Transactional Email Delivery (apps/api - Server-Side Only)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=onboarding@resend.dev
CONTACT_TO_EMAIL=nirmalpatil615@gmail.com
